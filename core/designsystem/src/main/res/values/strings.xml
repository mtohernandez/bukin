    <string name="sesiones_inscrito">Estás inscrito</string>
    <string name="sesiones_abrir">Abrir la sala</string>
    <string name="sesiones_crear">Crear sesión</string>
    <string name="sesiones_crear_title">Nueva sesión</string>
    <string name="sesiones_crear_nombre">Nombre del curso</string>
    <string name="sesiones_crear_duracion">Duración en minutos</string>
    <string name="sesiones_crear_confirmar">Crear y abrir</string>
    <string name="sesiones_cancelar">Cancelar</string>
    <string name="sesiones_cambiar_nombre">No soy %1$s</string>

    <!-- ===== Profile menu, reached from the avatar ===== -->
    <string name="perfil_abrir">Tu perfil</string>
    <string name="perfil_foto">Cambiar tu foto</string>
    <string name="perfil_foto_description">Tu foto de perfil</string>
    <string name="perfil_mi_asistencia">Mi asistencia</string>
    <string name="perfil_cambiar_nombre">Cambiar mi nombre</string>
    <string name="perfil_cerrar">Cerrar</string>

    <!-- ===== Mi asistencia: the receipt. Answers "¿sí quedó registrada?" at any time. ===== -->
    <string name="asistencia_title">Mi asistencia</string>
    <string name="asistencia_subtitulo">%1$d sesión registrada</string>
    <string name="asistencia_subtitulo_plural">%1$d sesiones registradas</string>
    <string name="asistencia_registrada">Registrada</string>
    <string name="asistencia_walk_in">Sin inscripción previa</string>
    <string name="asistencia_empty_title">Todavía no tienes asistencias</string>
    <string name="asistencia_empty_body">Cuando marques tu primera sesión, quedará aquí para que puedas comprobarlo cuando quieras.</string>
    <string name="asistencia_empty_action">Ver mis sesiones</string>

    <!-- ===== Check-in, waiting for the hour ===== -->
    <string name="checkin_esperando_title">Aún no es la hora</string>
    <string name="checkin_esperando_body">Podrás marcar tu asistencia desde las %1$s. Deja el Bluetooth encendido y vuelve entonces.</string>
    <string name="checkin_enviando">Registrando tu asistencia…</string>
    <string name="error_code_rejected_title">Ese código ya no sirve</string>
    <string name="error_code_rejected_body">La señal de tu anfitrión cambia cada 30 segundos. Volvemos a buscar la actual.</string>
    <string name="error_code_rejected_action">Buscar de nuevo</string>
    <!--
        Shown after the second rejection in a row. Deliberately stops claiming the problem
        is a stale code that will fix itself: at this point it is the room's signal not
        matching what the server has for this sesión, and looking again cannot repair that.
        Names the two things that actually can.
    -->
    <string name="error_code_mismatch_title">La señal de esta sala no coincide</string>
    <string name="error_code_mismatch_body">Lo intentamos varias veces y el servidor sigue rechazando el código. No es culpa tuya ni de tu teléfono. Pídele a tu anfitrión que cierre y vuelva a abrir la sala, o que te registre a mano.</string>
    <string name="error_code_mismatch_action">Intentar una vez más</string>
    <string name="error_out_of_window_title">Esta sesión no está abierta</string>
    <string name="error_out_of_window_body">Solo puedes marcar tu asistencia dentro del horario de la sesión.</string>
    <string name="error_out_of_window_action">Volver</string>

    <!--
        ===== "Necesito ayuda" =====
        Contextual: what the sheet offers while scanning is not what it offers after a
        rejected code. Every branch ends at the same last resort, and that last resort is a
        real path in the app (ManualRegistrationScreen), not a platitude.
    -->
    <string name="ayuda_title">Necesito ayuda</string>
    <string name="ayuda_que_pasa">Qué está pasando</string>
    <string name="ayuda_que_hacer">Qué puedes hacer</string>
    <string name="ayuda_ultimo_recurso">Si nada de esto funciona, pídele a tu anfitrión que te registre a mano. Queda igual de válido.</string>
    <string name="ayuda_cerrar">Entendido</string>

    <string name="ayuda_scanning_pasa">Tu teléfono está buscando la señal de tu anfitrión. Empieza solo, no tienes que tocar nada.</string>
    <string name="ayuda_scanning_tip_1">Acércate a la sala donde se dicta el curso.</string>
    <string name="ayuda_scanning_tip_2">Confirma con tu anfitrión que ya abrió la sala.</string>
    <string name="ayuda_scanning_tip_3">Deja el Bluetooth encendido mientras buscamos.</string>

    <string name="ayuda_esperando_pasa">La sesión todavía no abre, así que aún no hay nada que buscar.</string>
    <string name="ayuda_esperando_tip_1">Vuelve a las %1$s: la pantalla se habilita sola.</string>
    <string name="ayuda_esperando_tip_2">Deja el Bluetooth encendido para no perder tiempo al llegar.</string>

    <string name="ayuda_offline_pasa">Ya encontramos a tu anfitrión. Lo único que falta es guardar tu asistencia, y eso sí necesita internet.</string>
    <string name="ayuda_offline_tip_1">Revisa tus datos móviles o conéctate a un Wi-Fi.</string>
    <string name="ayuda_offline_tip_2">Cuando vuelva la conexión, toca Reintentar.</string>

    <string name="ayuda_ready_pasa">Encontramos a tu anfitrión y estás en la sala. Solo falta que toques Check In.</string>
    <string name="ayuda_ready_tip_1">Toca el botón grande. Es lo único que tienes que hacer.</string>

    <string name="ayuda_enviando_pasa">Estamos guardando tu asistencia. Toma un segundo.</string>
    <string name="ayuda_enviando_tip_1">No cierres la app hasta que aparezca la confirmación.</string>

    <string name="ayuda_success_pasa">Tu asistencia quedó registrada. No tienes que hacer nada más.</string>
    <string name="ayuda_success_tip_1">Puedes comprobarlo cuando quieras en Mi asistencia.</string>

