<?xml version="1.0" encoding="utf-8"?>
<!--
    Every user-facing string in the app. Colombian Spanish, warm, never bureaucratic.
    This is the only strings file in the project — features read from here.
-->
<resources>
    <string name="app_name">BukIn</string>

    <!-- ===== Onboarding ===== -->
    <string name="onboarding_one_title">Tu asistencia, en un toque</string>
    <string name="onboarding_one_body">Sin listas, sin fotos, sin códigos que escribir. Llegas, tocas una vez, listo.</string>

    <string name="onboarding_two_title">Tu teléfono encuentra a tu anfitrión</string>
    <string name="onboarding_two_body">Usamos Bluetooth para confirmar que estás en la sala. No usamos tu ubicación ni tu cámara. Solo deja el Bluetooth encendido.</string>

    <string name="onboarding_three_title">Por ahora, registramos tu entrada</string>
    <string name="onboarding_three_body">Marcas al llegar. La salida todavía la maneja tu anfitrión. Necesitas Bluetooth y conexión a internet en el momento de marcar.</string>

    <string name="onboarding_skip">Saltar</string>
    <string name="onboarding_next">Siguiente</string>
    <string name="onboarding_finish">Empezar</string>
    <string name="onboarding_page_indicator">Paso %1$d de %2$d</string>

    <!-- ===== Role picker ===== -->
    <string name="role_title">¿Cómo entras hoy?</string>
    <string name="role_collaborator">Soy colaborador</string>
    <string name="role_collaborator_hint">Vengo al curso y quiero marcar mi asistencia.</string>
    <string name="role_host">Soy anfitrión</string>
    <string name="role_host_hint">Yo dicto el curso y abro la sala.</string>

    <!-- ===== Host mode. An operator surface, so the copy is plainer than the rest. ===== -->
    <string name="host_title">Modo anfitrión</string>
    <string name="host_idle_body">Abre la sala para que tus colaboradores puedan marcar su asistencia.</string>
    <string name="host_start">Abrir la sala</string>
    <string name="host_stop">Cerrar la sala</string>
    <string name="host_back">Volver</string>
    <string name="host_starting">Encendiendo la señal…</string>
    <string name="host_broadcasting">La sala está abierta</string>
    <string name="host_code_label">Código actual</string>
    <string name="host_instancia_label">Instancia</string>
    <string name="host_window_label">Cambia en %1$d s</string>
    <string name="host_keep_open">Puedes bloquear la pantalla: la señal sigue encendida.</string>

    <string name="error_cannot_advertise_title">Este teléfono no puede abrir la sala</string>
    <string name="error_cannot_advertise_body">Su Bluetooth solo puede escuchar, no transmitir. Usa otro teléfono como anfitrión o registra la asistencia a mano.</string>
    <string name="error_advertise_failed_title">No pudimos encender la señal</string>
    <string name="error_advertise_failed_body">Bluetooth rechazó la transmisión (código %1$d). Apágalo y enciéndelo, y vuelve a abrir la sala.</string>

    <!-- Foreground-service notification while the host is broadcasting. -->
    <string name="host_notification_title">BukIn — sala abierta</string>
    <string name="host_notification_text">Tus colaboradores pueden marcar su asistencia.</string>

    <!-- ===== Diagnostics. Debug surface; plain and dense on purpose. ===== -->
    <string name="diag_title">Diagnóstico Bluetooth</string>
    <string name="diag_open">Diagnóstico</string>
    <string name="diag_adapter">Adaptador</string>
    <string name="diag_enabled">Bluetooth encendido</string>
    <string name="diag_can_advertise">Puede transmitir</string>
    <string name="diag_permissions">Permisos</string>
    <string name="diag_host_state">Estado del anfitrión</string>
    <string name="diag_sightings">Señales detectadas</string>
    <string name="diag_none_yet">Nada todavía.</string>
    <string name="diag_yes">sí</string>
    <string name="diag_no">no</string>

    <!-- ===== Ticket card ===== -->
    <string name="ticket_badge">Ticket</string>
    <string name="ticket_duration_label">Duración:</string>
    <string name="ticket_checkin_label">Check In</string>
    <string name="ticket_exit_label">Salida</string>
    <string name="ticket_help">Necesito ayuda</string>
    <string name="ticket_clock_description">Hora de inicio</string>

    <!-- ===== Check-in states ===== -->
    <string name="checkin_scanning">Estamos localizando a tu anfitrión…</string>
    <string name="checkin_button">Check In</string>
    <string name="checkin_success">Registraste tu asistencia exitosamente.</string>
    <string name="checkin_success_description">Asistencia registrada</string>
    <string name="checkin_proximity_description">Tu teléfono buscando al anfitrión</string>

    <!--
        Offline copy deliberately differs from the mockup. The mockup promised presence
        alone was enough; without internet v1 genuinely cannot save the attendance.
    -->
    <string name="checkin_offline_title">Sin conexión</string>
    <string name="checkin_offline_body">Podemos encontrar a tu anfitrión, pero necesitas internet para guardar tu asistencia.</string>

    <!-- ===== Blocked states: each names its cause and offers the way out ===== -->
    <string name="error_bluetooth_off_title">Tu Bluetooth está apagado</string>
    <string name="error_bluetooth_off_body">Lo necesitamos para encontrar a tu anfitrión en la sala.</string>
    <string name="error_bluetooth_off_action">Encender Bluetooth</string>

    <string name="error_no_host_title">No pudimos encontrar a tu anfitrión</string>
    <string name="error_no_host_body">Acércate un poco más a la sala y volvemos a buscar.</string>
    <string name="error_no_host_action">Buscar de nuevo</string>

    <!--
        Named separately from "Bluetooth apagado" on purpose: one is a switch the person can
        flip, the other is a phone that will never do this. Telling someone to turn on a
        radio their device does not have is the kind of dead end this app exists to remove.
    -->
    <string name="error_no_bluetooth_title">Este teléfono no tiene Bluetooth</string>
    <string name="error_no_bluetooth_body">Sin Bluetooth no podemos confirmar que estás en la sala. Pídele a tu anfitrión que te registre a mano.</string>

    <string name="error_permission_title">Necesitamos permiso para buscar dispositivos</string>
    <string name="error_permission_body">Solo lo usamos para encontrar a tu anfitrión en la sala. No accedemos a tu ubicación.</string>
    <string name="error_permission_action">Dar permiso</string>
    <!-- Shown once "no volver a preguntar" makes the dialog impossible to raise again. -->
    <string name="error_permission_settings_action">Abrir ajustes</string>

    <string name="error_scan_failed_title">No pudimos empezar a buscar</string>
    <string name="error_scan_failed_body">El Bluetooth de tu teléfono rechazó la búsqueda. Apagarlo y encenderlo suele bastar.</string>
    <string name="error_scan_failed_action">Reintentar</string>

    <string name="error_save_failed_title">No alcanzamos a guardar tu asistencia</string>
    <!-- Deliberately does not blame the connection: this state now covers a server that
         answered and refused, which "se cayó tu conexión" would misdiagnose. -->
    <string name="error_save_failed_body">Nada se perdió y no es culpa tuya. Vuelve a intentarlo.</string>
    <string name="error_save_failed_action">Reintentar</string>

    <!-- ===== Footer ===== -->
    <string name="footer_wordmark_prefix">·buk </string>
    <string name="footer_wordmark_italic">in</string>
    <string name="footer_wordmark_suffix">·</string>
    <string name="footer_microcopy">Usamos tecnología de proximidad,\nno desactives tu bluetooth.</string>

    <!-- ===== Ticket duration, formatted from duracion_minutos ===== -->
    <plurals name="ticket_duracion_horas">
        <item quantity="one">%1$d hora</item>
        <item quantity="other">%1$d horas</item>
    </plurals>
    <plurals name="ticket_duracion_minutos">
        <item quantity="one">%1$d minuto</item>
        <item quantity="other">%1$d minutos</item>
    </plurals>

    <!-- ===== Name entry. The whole identity model in v1: you type who you are. ===== -->
