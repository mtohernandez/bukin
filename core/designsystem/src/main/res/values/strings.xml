    <string name="nombre_body">Usamos tu nombre para registrar tu asistencia. Nada más.</string>
    <string name="nombre_label">Nombre y apellido</string>
    <string name="nombre_continue">Continuar</string>
    <string name="nombre_error">Escribe tu nombre para continuar.</string>

